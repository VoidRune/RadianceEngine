#version 450
#include "Particles.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) buffer StateBuffer { ParticleState State; };
layout(std430, set = 0, binding = 1) buffer ParticleBuffer { Particle Particles[]; };
layout(std430, set = 0, binding = 2) buffer ListBuffer { uint Lists[]; };
layout(std430, set = 0, binding = 4) readonly buffer FrameBuffer { ParticleFrame Frame; };
layout(std430, set = 0, binding = 6) readonly buffer SpawnBuffer { ParticleSpawn Spawns[]; };

vec3 ConeDirection(vec3 axis, float angle, inout uint state)
{
	float cosine = mix(1.0, cos(angle), Random(state));
	float sine = sqrt(max(1.0 - cosine * cosine, 0.0));
	float turn = Random(state) * 6.28318531;
	vec3 helper = abs(axis.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
	vec3 tangent = normalize(cross(helper, axis));
	vec3 bitangent = cross(axis, tangent);
	return normalize(axis * cosine + (tangent * cos(turn) + bitangent * sin(turn)) * sine);
}

void main()
{
	uint id = gl_GlobalInvocationID.x;
	if (id >= Frame.Counts.x || Frame.Counts.y == 0u)
		return;
	uint low = 0u;
	uint high = Frame.Counts.y - 1u;
	while (low < high)
	{
		uint middle = (low + high + 1u) / 2u;
		if (Spawns[middle].Info.x <= id)
			low = middle;
		else
			high = middle - 1u;
	}
	ParticleSpawn spawn = Spawns[low];

	uint capacity = Frame.Counts.w;
	uint previous = atomicAdd(State.DeadCount, 0xFFFFFFFFu);
	if (previous == 0u || previous > capacity)
	{
		atomicAdd(State.DeadCount, 1u);
		return;
	}
	uint index = Lists[previous - 1u];

	uint state = Hash((spawn.Info.w >> 8) ^ Hash(id * 747796405u + 2891336453u));
	uint shape = spawn.Info.w & 15u;
	bool outward = (spawn.Info.w & SpawnOutward) != 0u;
	vec3 origin = spawn.Origin.xyz;
	float radius = spawn.Origin.w;
	vec3 position = origin;
	if (shape == SpawnDisc || shape == SpawnRing)
	{
		float angle = Random(state) * 6.28318531;
		float distance = shape == SpawnRing ? radius : radius * sqrt(Random(state));
		position += vec3(cos(angle), 0.0, sin(angle)) * distance;
	}
	else if (shape == SpawnSegment)
		position += spawn.Segment.xyz * Random(state) + RandomDirection(state) * (radius * Random(state));
	else
		position += RandomDirection(state) * (radius * pow(Random(state), 0.3333));

	vec3 direction;
	if (outward)
	{
		vec3 away = position - origin;
		away = dot(away, away) > 1e-6 ? normalize(away) : RandomDirection(state);
		direction = normalize(ConeDirection(away, spawn.Direction.w, state) + spawn.Direction.xyz);
	}
	else
		direction = ConeDirection(normalize(spawn.Direction.xyz), spawn.Direction.w, state);

	float speed = mix(spawn.Velocity.w, spawn.Ranges.x, Random(state));
	float life = mix(spawn.Ranges.y, spawn.Ranges.z, Random(state));
	float size = mix(spawn.Ranges.w, spawn.Tint.w, Random(state));

	Particle particle;
	particle.PositionAge = vec4(position, 0.0);
	particle.VelocityLife = vec4(direction * speed + spawn.Velocity.xyz, max(life, 0.02));
	particle.TintSize = vec4(spawn.Tint.rgb, size);
	particle.Info = uvec4(spawn.Info.z, state, 0u, floatBitsToUint(Random(state) * 6.28318531));
	Particles[index] = particle;

	uint parity = Frame.Counts.z;
	uint slot = atomicAdd(State.AliveCount, 1u);
	Lists[capacity * (1u + parity) + slot] = index;
}
