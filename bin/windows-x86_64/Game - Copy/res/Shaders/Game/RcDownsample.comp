#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D SourceDepth;
layout(set = 0, binding = 1) uniform sampler2D SourceRadiance;
layout(set = 0, binding = 2) uniform sampler2D SourceEmitter;
layout(set = 0, binding = 3, rg16f) uniform writeonly image2D TargetDepth;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D TargetRadiance;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D TargetEmitter;

layout(push_constant) uniform PushConstants
{
	ivec2 Parity;
} pc;

void main()
{
	ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(TargetDepth);
	if (texel.x >= size.x || texel.y >= size.y)
		return;
	ivec2 last = textureSize(SourceDepth, 0) - 1;
	float depth = 65504.0;
	vec3 radiance = vec3(0.0);
	vec4 emitter = vec4(0.0);
	for (int j = 0; j < 2; j++)
		for (int i = 0; i < 2; i++)
		{
			ivec2 source = clamp(texel * 2 - 1 + pc.Parity + ivec2(i, j), ivec2(0), last);
			depth = min(depth, texelFetch(SourceDepth, source, 0).x);
			radiance += texelFetch(SourceRadiance, source, 0).rgb;
			emitter += texelFetch(SourceEmitter, source, 0);
		}
	imageStore(TargetDepth, texel, vec4(depth, 0.0, 0.0, 0.0));
	imageStore(TargetRadiance, texel, vec4(radiance * 0.25, 1.0));
	imageStore(TargetEmitter, texel, emitter * 0.25);
}
