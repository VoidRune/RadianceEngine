#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D Lower;
layout(set = 0, binding = 1) uniform sampler2D Current;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D Target;

layout(push_constant) uniform PushConstants
{
	vec2 LowerTexel;
	float Spread;
	float Padding;
} pc;

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(Target);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;
	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	vec2 t = pc.LowerTexel * pc.Spread;
	vec3 sum = textureLod(Lower, uv, 0.0).rgb * 4.0;
	sum += (textureLod(Lower, uv + vec2(t.x, 0.0), 0.0).rgb + textureLod(Lower, uv - vec2(t.x, 0.0), 0.0).rgb + textureLod(Lower, uv + vec2(0.0, t.y), 0.0).rgb + textureLod(Lower, uv - vec2(0.0, t.y), 0.0).rgb) * 2.0;
	sum += textureLod(Lower, uv + t, 0.0).rgb + textureLod(Lower, uv - t, 0.0).rgb + textureLod(Lower, uv + vec2(t.x, -t.y), 0.0).rgb + textureLod(Lower, uv + vec2(-t.x, t.y), 0.0).rgb;
	imageStore(Target, pixel, vec4(textureLod(Current, uv, 0.0).rgb + sum / 16.0, 1.0));
}
