#version 450
#include "GBuffer.glsl"
#include "Brdf.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D AlbedoBuffer;
layout(set = 0, binding = 1) uniform sampler2D SurfaceBuffer;
layout(set = 0, binding = 2) uniform sampler2D EmissionBuffer;
layout(set = 0, binding = 3) uniform sampler2D DepthBuffer;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D SceneColor;
layout(std140, set = 0, binding = 5) uniform LightingFrame
{
	mat4 InverseViewProjection;
	vec4 CameraPosition;
	vec4 SunDirection;
	vec4 SunRadiance;
	vec4 SkyRadiance;
	vec4 GroundRadiance;
	vec4 Background;
	uvec4 Options;
	mat4 ShadowMatrix;
	vec4 ShadowParams;
	vec4 GiParams;
	vec4 DepthRange;
	ivec4 GiShift;
} Frame;
layout(set = 0, binding = 6) uniform sampler2D ShadowMap;
#ifdef GLOBAL_ILLUMINATION
layout(set = 0, binding = 7) uniform sampler2D EmitterLight;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D GiRadiance;
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D GiEmitter;
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D GiDepth;

shared vec4 SharedRadiance[8][8];
shared vec3 SharedNormal[8][8];
#endif

const uint ViewLit = 0u;
const uint ViewAlbedo = 1u;
const uint ViewNormal = 2u;
const uint ViewRoughness = 3u;
const uint ViewMetallic = 4u;
const uint ViewOcclusion = 5u;
const uint ViewEmission = 6u;
const uint ViewSun = 7u;
const uint ViewAmbient = 8u;
const uint ViewShadow = 9u;
const uint ViewIrradiance = 10u;
const uint ViewGiSource = 11u;

const uint ShadowsOff = 0u;
const uint ShadowsLow = 1u;

const vec3 Luma = vec3(0.2126, 0.7152, 0.0722);

vec3 LinearToSrgb(vec3 color)
{
	return mix(color * 12.92, 1.055 * pow(color, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), color));
}

vec4 GatherLit(vec2 corner, vec2 size, float depth)
{
	return step(vec4(depth), textureGather(ShadowMap, corner / size, 0));
}

float SunShadow(vec3 position, vec3 normal, float cosI)
{
	uint quality = Frame.Options.w;
	if (quality == ShadowsOff)
		return 1.0;
	vec3 coord = (Frame.ShadowMatrix * vec4(position + normal * (Frame.ShadowParams.x * (1.5 - cosI)), 1.0)).xyz;
	if (any(lessThan(coord, vec3(0.0))) || any(greaterThan(coord, vec3(1.0))))
		return 1.0;
	float depth = coord.z - Frame.ShadowParams.y;
	vec2 size = vec2(textureSize(ShadowMap, 0));
	vec2 st = coord.xy * size - 0.5;
	vec2 base = floor(st);
	vec2 f = st - base;
	if (quality == ShadowsLow)
	{
		vec4 lit = GatherLit(base + 1.0, size, depth);
		return mix(mix(lit.w, lit.z, f.x), mix(lit.x, lit.y, f.x), f.y);
	}
	vec4 wx = vec4(1.0 - f.x, 1.0, 1.0, f.x);
	vec4 wy = vec4(1.0 - f.y, 1.0, 1.0, f.y);
	float sum = 0.0;
	for (int j = 0; j < 2; j++)
		for (int i = 0; i < 2; i++)
		{
			vec4 lit = GatherLit(base + vec2(2 * i, 2 * j), size, depth);
			vec2 x = vec2(wx[2 * i], wx[2 * i + 1]);
			vec2 y = vec2(wy[2 * j], wy[2 * j + 1]);
			sum += lit.w * x.x * y.x + lit.z * x.y * y.x + lit.x * x.x * y.y + lit.y * x.y * y.y;
		}
	return sum / 9.0;
}

float LinearDepth(float depth)
{
	float near = Frame.DepthRange.x;
	float far = Frame.DepthRange.y;
	return near * far / (far - depth * (far - near));
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) + Frame.GiShift.xy;
	ivec2 size = ivec2(Frame.Options.yz);
	bool inside = all(greaterThanEqual(pixel, ivec2(0))) && all(lessThan(pixel, size));
	float depth = inside ? texelFetch(DepthBuffer, pixel, 0).r : 1.0;
	vec3 result = Frame.Background.rgb;
	vec3 source = vec3(0.0);
	vec2 encodedNormal = vec2(0.5);
	float priority = inside ? 2.0 : 0.0;
	if (depth < 1.0)
	{
		vec2 screen = (vec2(pixel) + 0.5) / vec2(size);
		vec4 world = Frame.InverseViewProjection * vec4(screen * 2.0 - 1.0, depth, 1.0);
		vec3 position = world.xyz / world.w;

		vec4 albedo = texelFetch(AlbedoBuffer, pixel, 0);
		vec4 surface = texelFetch(SurfaceBuffer, pixel, 0);
		vec4 emissive = texelFetch(EmissionBuffer, pixel, 0);
		vec3 emission = emissive.rgb;
		if (emissive.a > 0.5)
			priority = 1.0;
		vec3 n = DecodeNormal(surface.xy);
		encodedNormal = surface.xy;
		float roughness = surface.z;
		float metallic = 1.0 - surface.w;
		vec3 v = normalize(Frame.CameraPosition.xyz - position);
		float cosO = dot(n, v);
		if (cosO < 0.01)
			n = normalize(n + v * (0.01 - cosO));

		vec3 l = Frame.SunDirection.xyz;
		float cosI = dot(n, l);
		float shadow = cosI > 0.0 ? SunShadow(position, n, cosI) : 0.0;
		vec3 sunIrradiance = Frame.SunRadiance.rgb * (max(cosI, 0.0) * shadow);
		vec3 sun = EvaluateBrdf(albedo.rgb, metallic, roughness, n, v, l) * sunIrradiance;
		float fade = DepthFade(Frame.CameraPosition.w, position.y);
		vec3 skyIrradiance = HemisphereRadiance(Frame.SkyRadiance.rgb, Frame.GroundRadiance.rgb, n.y, 1.0);
#ifdef GLOBAL_ILLUMINATION
		vec3 ambient = vec3(0.0);
		vec2 border = min(vec2(pixel) + 0.5, vec2(size - pixel) - 0.5);
		float edge = clamp(min(border.x, border.y) / (2.0 * Frame.GiParams.z), 0.0, 1.0);
		source = albedo.rgb * (sunIrradiance * InvPi + skyIrradiance * albedo.a) * (1.0 - fade) + emission * (Frame.GiParams.x * edge);
#else
		vec3 ambient = EvaluateAmbient(albedo.rgb, metallic, roughness, albedo.a, n, v, Frame.SkyRadiance.rgb, Frame.GroundRadiance.rgb);
#endif
		vec3 lit = mix(sun + ambient, DepthColor, fade);

		result = lit + emission;
		switch (Frame.Options.x)
		{
		case ViewAlbedo:
			result = LinearToSrgb(albedo.rgb);
			break;
		case ViewNormal:
			result = n * 0.5 + 0.5;
			break;
		case ViewRoughness:
			result = vec3(roughness);
			break;
		case ViewMetallic:
			result = vec3(metallic);
			break;
		case ViewOcclusion:
			result = vec3(albedo.a);
			break;
		case ViewEmission:
			result = emission;
			break;
		case ViewSun:
			result = sun;
			break;
		case ViewAmbient:
			result = ambient;
			break;
		case ViewShadow:
			result = vec3(shadow);
			break;
		case ViewIrradiance:
			result = skyIrradiance;
			break;
		case ViewGiSource:
			result = source;
#ifdef GLOBAL_ILLUMINATION
			result += texelFetch(EmitterLight, min(pixel / 2, textureSize(EmitterLight, 0) - 1), 0).rgb * Frame.GiParams.y;
#endif
			break;
		}
	}
	if (inside)
		imageStore(SceneColor, pixel, vec4(result, 1.0));

#ifdef GLOBAL_ILLUMINATION
	uvec2 local = gl_LocalInvocationID.xy;
	SharedRadiance[local.y][local.x] = vec4(source, depth < 1.0 ? LinearDepth(depth) : Frame.DepthRange.y);
	SharedNormal[local.y][local.x] = vec3(encodedNormal, priority);
	barrier();
	if ((local.x & 1u) != 0u || (local.y & 1u) != 0u)
		return;
	ivec2 halfPixel = ivec2(gl_GlobalInvocationID.xy) / 2;
	ivec2 halfSize = imageSize(GiRadiance);
	if (halfPixel.x >= halfSize.x || halfPixel.y >= halfSize.y)
		return;
	float best = max(max(SharedNormal[local.y][local.x].z, SharedNormal[local.y][local.x + 1u].z), max(SharedNormal[local.y + 1u][local.x].z, SharedNormal[local.y + 1u][local.x + 1u].z));
	float nearest = Frame.DepthRange.y;
	vec2 normal = vec2(0.5);
	for (uint j = 0u; j < 2u; j++)
		for (uint i = 0u; i < 2u; i++)
		{
			vec3 encoded = SharedNormal[local.y + j][local.x + i];
			float z = SharedRadiance[local.y + j][local.x + i].a;
			if (best > 0.0 && encoded.z == best && z < nearest)
			{
				nearest = z;
				normal = encoded.xy;
			}
		}
	vec3 radiance = vec3(0.0);
	float count = 0.0;
	for (uint j = 0u; j < 2u; j++)
		for (uint i = 0u; i < 2u; i++)
			if (best > 0.0 && SharedNormal[local.y + j][local.x + i].z == best)
			{
				radiance += SharedRadiance[local.y + j][local.x + i].rgb;
				count += 1.0;
			}
	radiance /= max(count, 1.0);

	vec2 border = min(vec2(halfPixel) + 0.5, vec2(halfSize - halfPixel) - 0.5);
	float edge = clamp(min(border.x, border.y) / Frame.GiParams.z, 0.0, 1.0);
	ivec2 emitterTexel = clamp((halfPixel * 2 + Frame.GiShift.zw - 1) >> 1, ivec2(0), textureSize(EmitterLight, 0) - 1);
	vec4 particles = texelFetch(EmitterLight, emitterTexel, 0);
	vec3 emitter = particles.rgb * (Frame.GiParams.y * edge);
	float luminance = dot(particles.rgb, Luma);
	float emitterDepth = luminance > 1e-6 ? particles.a / luminance : 0.0;
	imageStore(GiRadiance, halfPixel, vec4(radiance, 1.0));
	imageStore(GiEmitter, halfPixel, vec4(emitter, dot(emitter, Luma) * emitterDepth));
	imageStore(GiDepth, halfPixel, vec4(nearest, 0.0, normal));
#endif
}
