#version 450
#include "GBuffer.glsl"
#include "Brdf.glsl"
#include "Rc.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 1) uniform sampler2D Depth;
layout(set = 0, binding = 2) uniform sampler2D Height;
layout(set = 0, binding = 3, rgba32ui) uniform writeonly uimage2D Probes;

layout(push_constant) uniform PushConstants
{
	vec4 Lattice;
	uvec4 Grid;
} pc;

const float FlatNormal = 0.9;
const float SideNormal = 0.3;
const float FlatRelief = 0.04;
const float FlatSlope = 0.02;
const ivec2 ReliefOffsets[4] = ivec2[](ivec2(2, 0), ivec2(-2, 0), ivec2(0, 2), ivec2(0, -2));

bool FlatTop(ivec2 texel, inout float height)
{
	vec4 neighbours;
	for (int k = 0; k < 4; k++)
		neighbours[k] = texelFetch(Height, clamp(texel + ReliefOffsets[k], ivec2(0), LevelSize(0) - 1), 0).x;
	bvec4 matching = lessThanEqual(abs(neighbours - height), vec4(FlatRelief));
	if (dot(vec4(matching), vec4(1.0)) < 2.5)
		return false;
	if ((matching.x && matching.y && abs(neighbours.x - neighbours.y) > FlatSlope) || (matching.z && matching.w && abs(neighbours.z - neighbours.w) > FlatSlope))
		return false;
	height = max(height, max(max(matching.x ? neighbours.x : height, matching.y ? neighbours.y : height), max(matching.z ? neighbours.z : height, matching.w ? neighbours.w : height)));
	return true;
}

bool Horizontal(ivec2 texel, vec4 surface, inout float height)
{
	float upward = DecodeNormal(surface.zw).y;
	if (surface.y > 0.5 && upward >= FlatNormal)
		return true;
	return upward > SideNormal && FlatTop(texel, height);
}

void main()
{
	ivec2 probe = ivec2(gl_GlobalInvocationID.xy);
	if (probe.x >= int(pc.Grid.x) || probe.y >= int(pc.Grid.y))
		return;
	float spacing = pc.Lattice.x;
	ivec2 texel = ProbeTexel(probe, spacing, pc.Lattice.yz);
	vec4 surface = texelFetch(Depth, texel, 0);
	if (IsBackground(surface.x))
	{
		imageStore(Probes, probe, uvec4(floatBitsToUint(vec3(0.0, 0.0, Rc.Projection.w)), 0u));
		return;
	}
	vec2 home = vec2(texel) - 0.5;
	vec2 coordinate = home;
	float height = texelFetch(Height, texel, 0).x;
	int band = HeightBand(height);
	bool locked = false;
	if (pc.Lattice.w > 0.5)
	{
		int best = -32768;
		for (int j = -1; j <= 1; j++)
			for (int i = -1; i <= 1; i++)
			{
				ivec2 source = ProbeTexel(probe + ivec2(i, j), spacing, pc.Lattice.yz);
				if (IsBackground(texelFetch(Depth, source, 0).x))
					continue;
				int candidateBand = HeightBand(texelFetch(Height, source, 0).x);
				if (candidateBand <= best)
					continue;
				vec2 node = home + LatticeShift(candidateBand, spacing, Rc.Lattice);
				ivec2 nodeTexel = clamp(ivec2(floor(node)) + 1, ivec2(0), LevelSize(0) - 1);
				vec4 nodeSurface = texelFetch(Depth, nodeTexel, 0);
				float nodeHeight = texelFetch(Height, nodeTexel, 0).x;
				if (IsBackground(nodeSurface.x) || HeightBand(nodeHeight) != candidateBand || !Horizontal(nodeTexel, nodeSurface, nodeHeight))
					continue;
				best = candidateBand;
				coordinate = node;
				height = nodeHeight;
				band = candidateBand;
				locked = true;
			}
	}
	bool horizontal = locked || Horizontal(texel, surface, height);
	vec2 normal = horizontal ? EncodeNormal(vec3(0.0, 1.0, 0.0)) : surface.zw;
	imageStore(Probes, probe, PackProbe(DomainGround(coordinate) * (1.0 - height / Rc.Lattice.z), normal, band, locked));
}
