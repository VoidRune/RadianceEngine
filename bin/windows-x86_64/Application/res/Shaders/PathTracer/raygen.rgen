#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#include "common.glsl"
#include "scene.glsl"
#include "bsdf.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba32f) uniform image2D accumulationImageIn;
layout(set = 0, binding = 2, rgba32f) uniform image2D accumulationImageOut;
layout(set = 0, binding = 3, rgba8) uniform image2D outputImage;
layout(set = 0, binding = 4) uniform GlobalData
{
    vec4 cameraPosition;
    vec4 cameraForward;
    vec4 cameraRight;
    vec4 cameraUp;
    float tanHalfFov;
    float aspectRatio;
    float aperture;
    float focusDistance;
    uint frameIndex;
    uint maxBounces;
    float exposure;
    uint samplesPerPixel;
} globalData;

layout(location = 0) rayPayloadEXT HitPayload payload;

const int MEDIUM_STACK_SIZE = 4;
const int MAX_NULL_CROSSINGS = 64;

struct MediumStack
{
    int media[MEDIUM_STACK_SIZE];
    int depth;
};

struct LightSample
{
    vec3 position;
    vec3 normal;
    vec3 emission;
    float pdfArea;
};

MediumStack CreateMediumStack()
{
    MediumStack stack;
    for (int i = 0; i < MEDIUM_STACK_SIZE; i++)
        stack.media[i] = -1;
    stack.media[0] = globalMedium;
    stack.depth = 0;
    return stack;
}

int CurrentMedium(MediumStack stack)
{
    return stack.media[stack.depth];
}

void CrossBoundary(inout MediumStack stack, bool entering, int medium)
{
    if (entering)
    {
        stack.depth = min(stack.depth + 1, MEDIUM_STACK_SIZE - 1);
        stack.media[stack.depth] = medium;
    }
    else
    {
        stack.depth = max(stack.depth - 1, 0);
    }
}

bool TraceClosest(vec3 origin, vec3 direction, float tMax)
{
    payload.t = -1.0;
    traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, origin, 0.0, direction, tMax, 0);
    return payload.t >= 0.0;
}

SurfaceMaterial FetchMaterial(uint index, vec2 uv)
{
    Material m = materials[index];
    SurfaceMaterial material;
    material.baseColor = m.baseColor * textureLod(textures[nonuniformEXT(m.textureIndex)], uv, 0.0).rgb;
    material.metallic = m.metallic;
    material.emission = m.emission;
    material.roughness = m.roughness;
    material.sheen = m.sheen;
    material.transmission = m.transmission;
    material.ior = m.ior;
    material.clearcoat = m.clearcoat;
    material.clearcoatRoughness = m.clearcoatRoughness;
    material.medium = m.mediumIndex;
    material.nullSurface = (m.flags & MATERIAL_NULL_SURFACE) != 0u;
    return material;
}

float HenyeyGreenstein(float cosTheta, float g)
{
    float denom = max(1.0 + g * g + 2.0 * g * cosTheta, 1e-12);
    return INV_4PI * (1.0 - g * g) / (denom * sqrt(denom));
}

vec3 SampleHenyeyGreenstein(vec3 wo, float g, vec2 u, out float pdf)
{
    float cosTheta;
    if (abs(g) < 1e-3)
    {
        cosTheta = 1.0 - 2.0 * u.x;
    }
    else
    {
        float s = (1.0 - g * g) / (1.0 + g - 2.0 * g * u.x);
        cosTheta = -(1.0 + g * g - s * s) / (2.0 * g);
    }
    cosTheta = clamp(cosTheta, -1.0, 1.0);
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    float phi = TWO_PI * u.y;
    pdf = HenyeyGreenstein(cosTheta, g);
    return ToWorld(BuildFrame(wo), vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta));
}

bool SampleMediumInteraction(Medium medium, float tMax, int hero, inout vec3 beta, inout vec3 spectralPdf, inout uint rng, out float t)
{
    t = tMax;
    vec3 sigmaT = medium.sigmaA + medium.sigmaS;
    if (MaxComponent(medium.sigmaS) <= 0.0)
    {
        beta *= exp(-sigmaT * tMax);
        return false;
    }

    float previousPdf = Average(spectralPdf);
    float distance = sigmaT[hero] > 0.0 ? -log(max(1.0 - Random(rng), 1e-12)) / sigmaT[hero] : INF;
    if (distance < tMax)
    {
        vec3 transmittance = exp(-sigmaT * distance);
        vec3 density = sigmaT * transmittance;
        spectralPdf *= density / density[hero];
        beta *= transmittance * medium.sigmaS / density[hero] * (previousPdf / Average(spectralPdf));
        t = distance;
        return true;
    }

    vec3 transmittance = exp(-sigmaT * tMax);
    spectralPdf *= transmittance / transmittance[hero];
    beta *= transmittance / transmittance[hero] * (previousPdf / Average(spectralPdf));
    return false;
}

bool SampleLight(inout uint rng, out LightSample light)
{
    if (lightCount == 0u || totalLightPower <= 0.0)
        return false;

    float u = Random(rng);
    uint low = 0u;
    uint high = lightCount - 1u;
    while (low < high)
    {
        uint mid = (low + high) / 2u;
        if (lights[mid].cdf < u)
            low = mid + 1u;
        else
            high = mid;
    }

    LightTriangle triangle = lights[low];
    vec3 bary = SampleUniformTriangle(Random2(rng));
    light.position = triangle.p0 * bary.x + triangle.p1 * bary.y + triangle.p2 * bary.z;
    light.normal = normalize(cross(triangle.p1 - triangle.p0, triangle.p2 - triangle.p0));
    light.emission = triangle.emission;
    light.pdfArea = Luminance(triangle.emission) / totalLightPower;
    return true;
}

float LightPdfArea(vec3 emission)
{
    return totalLightPower > 0.0 ? Luminance(emission) / totalLightPower : 0.0;
}

vec3 Transmittance(vec3 origin, vec3 target, MediumStack stack)
{
    vec3 transmittance = vec3(1.0);
    for (int i = 0; i < MAX_NULL_CROSSINGS; i++)
    {
        vec3 toTarget = target - origin;
        float distance = length(toTarget);
        vec3 direction = toTarget / distance;
        bool hit = TraceClosest(origin, direction, distance * 0.9999);
        float segment = hit ? payload.t : distance;

        int mediumIndex = CurrentMedium(stack);
        if (mediumIndex >= 0)
            transmittance *= exp(-(media[mediumIndex].sigmaA + media[mediumIndex].sigmaS) * segment);
        if (!hit)
            return transmittance;

        Material material = materials[payload.materialIndex];
        if ((material.flags & MATERIAL_NULL_SURFACE) == 0u || MaxComponent(transmittance) <= 0.0)
            return vec3(0.0);

        CrossBoundary(stack, payload.frontFace != 0u, material.mediumIndex);
        vec3 ng = payload.geometricNormal;
        origin = OffsetRay(payload.position, dot(direction, ng) > 0.0 ? ng : -ng);
    }
    return vec3(0.0);
}

vec3 DirectLightingSurface(vec3 position, vec3 ng, vec3 wo, mat3 frame, Bsdf bsdf, int surfaceMedium, MediumStack stack, inout uint rng)
{
    LightSample light;
    if (!SampleLight(rng, light))
        return vec3(0.0);

    vec3 toLight = light.position - position;
    float distance2 = dot(toLight, toLight);
    vec3 wi = toLight * inversesqrt(distance2);
    float cosLight = dot(light.normal, -wi);
    if (cosLight <= 0.0)
        return vec3(0.0);

    float bsdfPdf;
    vec3 f = EvalBsdf(bsdf, ToLocal(frame, wo), ToLocal(frame, wi), ToLocal(frame, ng), bsdfPdf);
    if (MaxComponent(f) <= 0.0)
        return vec3(0.0);

    bool outside = dot(wi, ng) > 0.0;
    if (outside != (dot(wo, ng) > 0.0))
        CrossBoundary(stack, !outside, surfaceMedium);
    vec3 transmittance = Transmittance(OffsetRay(position, outside ? ng : -ng), light.position, stack);
    if (MaxComponent(transmittance) <= 0.0)
        return vec3(0.0);

    float lightPdf = light.pdfArea * distance2 / cosLight;
    return f * abs(dot(wi, frame[2])) * light.emission * transmittance * (PowerHeuristic(lightPdf, bsdfPdf) / lightPdf);
}

vec3 DirectLightingMedium(vec3 position, vec3 wo, float g, MediumStack stack, inout uint rng)
{
    LightSample light;
    if (!SampleLight(rng, light))
        return vec3(0.0);

    vec3 toLight = light.position - position;
    float distance2 = dot(toLight, toLight);
    vec3 wi = toLight * inversesqrt(distance2);
    float cosLight = dot(light.normal, -wi);
    if (cosLight <= 0.0)
        return vec3(0.0);

    vec3 transmittance = Transmittance(position, light.position, stack);
    if (MaxComponent(transmittance) <= 0.0)
        return vec3(0.0);

    float phase = HenyeyGreenstein(dot(wo, wi), g);
    float lightPdf = light.pdfArea * distance2 / cosLight;
    return phase * light.emission * transmittance * (PowerHeuristic(lightPdf, phase) / lightPdf);
}

bool RussianRoulette(inout vec3 beta, uint depth, inout uint rng)
{
    if (depth < 3u)
        return false;
    float survival = min(MaxComponent(beta), 0.95);
    if (survival <= 0.0 || Random(rng) >= survival)
        return true;
    beta /= survival;
    return false;
}

vec3 TracePath(vec3 origin, vec3 direction, inout uint rng)
{
    vec3 radiance = vec3(0.0);
    vec3 beta = vec3(1.0);
    vec3 spectralPdf = vec3(1.0);
    int hero = min(int(Random(rng) * 3.0), 2);
    MediumStack stack = CreateMediumStack();
    vec3 previousPosition = origin;
    float previousPdf = 0.0;
    bool previousNee = false;
    uint depth = 0u;
    int nullCrossings = 0;

    while (true)
    {
        bool hit = TraceClosest(origin, direction, INF);
        HitPayload surface = payload;

        int mediumIndex = CurrentMedium(stack);
        if (mediumIndex >= 0)
        {
            Medium medium = media[mediumIndex];
            float t;
            if (SampleMediumInteraction(medium, hit ? surface.t : INF, hero, beta, spectralPdf, rng, t))
            {
                if (++depth > globalData.maxBounces)
                    break;

                vec3 position = origin + direction * t;
                vec3 wo = -direction;
                radiance += beta * DirectLightingMedium(position, wo, medium.g, stack, rng);

                float phasePdf;
                direction = SampleHenyeyGreenstein(wo, medium.g, Random2(rng), phasePdf);
                origin = position;
                previousPosition = position;
                previousPdf = phasePdf;
                previousNee = true;
                if (RussianRoulette(beta, depth, rng))
                    break;
                continue;
            }
            if (MaxComponent(beta) <= 0.0)
                break;
        }

        if (!hit)
        {
            radiance += beta * EnvironmentRadiance(direction);
            break;
        }

        SurfaceMaterial material = FetchMaterial(surface.materialIndex, surface.uv);
        vec3 ng = surface.geometricNormal;
        bool frontFace = surface.frontFace != 0u;

        if (material.nullSurface)
        {
            if (++nullCrossings > MAX_NULL_CROSSINGS)
                break;
            CrossBoundary(stack, frontFace, material.medium);
            origin = OffsetRay(surface.position, frontFace ? -ng : ng);
            continue;
        }

        if (frontFace && MaxComponent(material.emission) > 0.0)
        {
            float weight = 1.0;
            if (previousNee)
            {
                vec3 toLight = surface.position - previousPosition;
                float lightPdf = LightPdfArea(material.emission) * dot(toLight, toLight) / max(dot(ng, -direction), 1e-8);
                weight = PowerHeuristic(previousPdf, lightPdf);
            }
            radiance += beta * material.emission * weight;
        }

        if (++depth > globalData.maxBounces)
            break;

        vec3 wo = -direction;
        mat3 frame = BuildFrame(surface.shadingNormal);
        vec3 woLocal = ToLocal(frame, wo);
        vec3 ngLocal = ToLocal(frame, ng);
        Bsdf bsdf = CreateBsdf(material, woLocal);

        bool nee = BsdfHasSmoothLobes(bsdf);
        if (nee)
            radiance += beta * DirectLightingSurface(surface.position, ng, wo, frame, bsdf, material.medium, stack, rng);

        vec3 wiLocal;
        vec3 f;
        float pdf;
        if (!SampleBsdf(bsdf, woLocal, ngLocal, rng, wiLocal, f, pdf))
            break;

        vec3 wi = ToWorld(frame, wiLocal);
        beta *= f * abs(wiLocal.z) / pdf;

        bool outside = dot(wi, ng) > 0.0;
        if (outside != (dot(wo, ng) > 0.0))
            CrossBoundary(stack, !outside, material.medium);

        origin = OffsetRay(surface.position, outside ? ng : -ng);
        direction = wi;
        previousPosition = surface.position;
        previousPdf = pdf;
        previousNee = nee;
        if (RussianRoulette(beta, depth, rng))
            break;
    }
    return radiance;
}

vec3 TonemapAces(vec3 color)
{
    const mat3 inputMatrix = mat3(0.59719, 0.07600, 0.02840, 0.35458, 0.90834, 0.13383, 0.04823, 0.01566, 0.83777);
    const mat3 outputMatrix = mat3(1.60475, -0.10208, -0.00327, -0.53108, 1.10813, -0.07276, -0.07367, -0.00605, 1.07602);
    color = inputMatrix * color;
    vec3 a = color * (color + 0.0245786) - 0.000090537;
    vec3 b = color * (0.983729 * color + 0.4329510) + 0.238081;
    return clamp(outputMatrix * (a / b), 0.0, 1.0);
}

vec3 LinearToSrgb(vec3 color)
{
    return mix(color * 12.92, 1.055 * pow(color, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), color));
}

void main()
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    uint rng = PcgHash(uint(pixel.x) + PcgHash(uint(pixel.y) + PcgHash(globalData.frameIndex)));

    vec3 cameraPosition = globalData.cameraPosition.xyz;
    vec3 forward = globalData.cameraForward.xyz;
    vec3 right = globalData.cameraRight.xyz;
    vec3 up = globalData.cameraUp.xyz;

    vec3 radiance = vec3(0.0);
    uint samples = max(globalData.samplesPerPixel, 1u);
    for (uint s = 0u; s < samples; s++)
    {
        vec2 uv = (vec2(pixel) + Random2(rng)) / vec2(gl_LaunchSizeEXT.xy);
        vec2 d = uv * 2.0 - 1.0;
        vec3 direction = normalize(forward + d.x * globalData.aspectRatio * globalData.tanHalfFov * right + d.y * globalData.tanHalfFov * up);
        vec3 origin = cameraPosition;
        if (globalData.aperture > 0.0)
        {
            vec3 focusPoint = cameraPosition + direction * (globalData.focusDistance / dot(direction, forward));
            vec2 lens = SampleUniformDisk(Random2(rng)) * globalData.aperture;
            origin = cameraPosition + right * lens.x + up * lens.y;
            direction = normalize(focusPoint - origin);
        }

        vec3 sampleRadiance = TracePath(origin, direction, rng);
        if (any(isnan(sampleRadiance)) || any(isinf(sampleRadiance)))
            sampleRadiance = vec3(0.0);
        radiance += sampleRadiance;
    }
    radiance /= float(samples);

    vec3 accumulated = radiance;
    if (globalData.frameIndex > 1u)
        accumulated += imageLoad(accumulationImageIn, pixel).rgb;
    imageStore(accumulationImageOut, pixel, vec4(accumulated, 0.0));

    vec3 color = accumulated / float(max(globalData.frameIndex, 1u)) * globalData.exposure;
    imageStore(outputImage, pixel, vec4(LinearToSrgb(TonemapAces(color)), 1.0));
}
