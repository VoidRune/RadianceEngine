#version 450
#include "GBuffer.glsl"
#include "Brdf.glsl"
#include "Rc.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 1) uniform sampler2D Source;
layout(set = 0, binding = 2) uniform sampler2D DepthBuffer;
layout(set = 0, binding = 3) uniform sampler2D SurfaceBuffer;
layout(set = 0, binding = 4) uniform sampler2D ParticleLight;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D Radiance;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D Emitter;
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D Depth;
layout(set = 0, binding = 8) uniform sampler2D BackDepth;
layout(set = 0, binding = 9, rg32f) uniform writeonly image2D Height;

layout(push_constant) uniform PushConstants
{
	vec4 Params;
} pc;

const vec3 Luma = vec3(0.2126, 0.7152, 0.0722);
const ivec2 GatherOffsets[4] = ivec2[](ivec2(0, 1), ivec2(1, 1), ivec2(1, 0), ivec2(0, 0));
const vec2 SourceKnee = vec2(3.0, 6.0);
const vec2 EmitterKnee = vec2(2.0, 4.0);

vec3 Compress(vec3 value, vec2 knee)
{
	float luminance = dot(value, Luma);
	if (luminance <= knee.x)
		return value;
	float excess = luminance - knee.x;
	return value * ((knee.x + excess / (1.0 + excess / (knee.y - knee.x))) / luminance);
}

void main()
{
	ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(texel, LevelSize(0))))
		return;
	vec4 radiance = vec4(0.0, 0.0, 0.0, 1.0);
	vec4 emitter = vec4(0.0);
	vec4 depth = vec4(Rc.Projection.w, Rc.Projection.w, 0.5, 0.5);
	vec2 height = vec2(-1e4);
	vec3 ground = DomainGround(vec2(texel) - 0.5);
	vec2 uv = ProjectUv(ground);
	if (ground.z > Rc.Projection.z && all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0))))
	{
		vec2 pixel = uv * Rc.Screen.xy - 0.5;
		ivec2 base = ivec2(floor(pixel));
		vec2 f = pixel - vec2(base);
		vec2 gatherUv = (vec2(base) + 1.0) / Rc.Screen.xy;
		vec4 priority = textureGather(Source, gatherUv, 3);
		vec4 weights = vec4((1.0 - f.x) * f.y, f.x * f.y, f.x * (1.0 - f.y), (1.0 - f.x) * (1.0 - f.y));
		float best = max(max(priority.x, priority.y), max(priority.z, priority.w));
		vec4 mask = vec4(equal(priority, vec4(best)));
		vec4 z;
		for (int k = 0; k < 4; k++)
		{
			float raw = texelFetch(DepthBuffer, clamp(base + GatherOffsets[k], ivec2(0), ivec2(Rc.Screen.xy) - 1), 0).r;
			z[k] = raw < 1.0 ? LinearDepth(raw) : Rc.Projection.w;
		}
		vec4 masked = vec4(greaterThan(mask, vec4(0.5))) * z + vec4(lessThan(mask, vec4(0.5))) * 1e6;
		float nearest = min(min(masked.x, masked.y), min(masked.z, masked.w));
		float farthest = max(max(z.x * mask.x, z.y * mask.y), max(z.z * mask.z, z.w * mask.w));
		int chosen = 0;
		for (int k = 1; k < 4; k++)
			if (masked[k] < masked[chosen])
				chosen = k;
		ivec2 chosenPixel = clamp(base + GatherOffsets[chosen], ivec2(0), ivec2(Rc.Screen.xy) - 1);
		vec2 normal = texelFetch(SurfaceBuffer, chosenPixel, 0).xy;
		float surface = nearest;
		bool planar = false;
		if (dot(mask, vec4(1.0)) > 3.5 && farthest - nearest < 0.02 * nearest + 0.02 && !IsBackground(farthest))
		{
			vec4 inverse = 1.0 / z;
			surface = 1.0 / dot(weights, inverse);
			if (abs(inverse.x + inverse.z - inverse.y - inverse.w) < 2e-4 * inverse.w)
			{
				vec2 corner = (vec2(base) + 0.5) / Rc.Screen.xy;
				vec2 step = 1.0 / Rc.Screen.xy;
				vec3 origin = ViewPosition(corner, z.w);
				vec3 geometric = normalize(cross(ViewPosition(corner + step, z.y) - origin, ViewPosition(corner + vec2(0.0, step.y), z.x) - ViewPosition(corner + vec2(step.x, 0.0), z.z)));
				normal = EncodeNormal(mat3(Rc.InverseView) * (dot(geometric, origin) > 0.0 ? -geometric : geometric));
				planar = true;
			}
		}
		vec4 sampleWeights = weights * mask;
		float total = max(dot(sampleWeights, vec4(1.0)), 1e-6);
		radiance.rgb = Compress(vec3(dot(textureGather(Source, gatherUv, 0), sampleWeights), dot(textureGather(Source, gatherUv, 1), sampleWeights), dot(textureGather(Source, gatherUv, 2), sampleWeights)) / total, SourceKnee);
		float rawBack = pc.Params.z > 0.5 ? texelFetch(BackDepth, chosenPixel, 0).r : 1.0;
		float back = rawBack < 1.0 ? LinearDepth(rawBack) : 0.0;
		height = Rc.Lattice.z * (1.0 - vec2(surface, back > surface + 0.02 ? back : surface + Rc.Trace.x) / ground.z);
		depth = vec4(surface, planar ? 1.0 : 0.0, normal);

		vec2 border = min(uv, 1.0 - uv) * Rc.Screen.zw;
		float edge = clamp(min(border.x, border.y) / pc.Params.y, 0.0, 1.0);
		vec4 particles = textureLod(ParticleLight, uv, 0.0);
		vec3 light = Compress(particles.rgb * pc.Params.x, EmitterKnee) * edge;
		float luminance = dot(particles.rgb, Luma);
		float emitterDepth = luminance > 1e-6 ? particles.a / luminance : 0.0;
		emitter = vec4(light, dot(light, Luma) * emitterDepth);
	}
	imageStore(Radiance, texel, radiance);
	imageStore(Emitter, texel, emitter);
	imageStore(Depth, texel, depth);
	imageStore(Height, texel, vec4(height, 0.0, 0.0));
}
