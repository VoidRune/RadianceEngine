#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rg32f) uniform image2D Heights;
layout(set = 0, binding = 1) uniform sampler2D SourceRadiance;
layout(set = 0, binding = 2) uniform sampler2D SourceEmitter;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D TargetRadiance;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D TargetEmitter;

layout(push_constant) uniform PushConstants
{
	ivec4 Parity;
	ivec4 Origins;
	ivec4 Sizes;
} pc;

void main()
{
	ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
	if (texel.x >= pc.Sizes.z || texel.y >= pc.Sizes.w)
		return;
	ivec2 last = pc.Sizes.xy - 1;
	vec2 height = vec2(-1e30, 1e30);
	vec3 radiance = vec3(0.0);
	vec4 emitter = vec4(0.0);
	for (int j = 0; j < 2; j++)
		for (int i = 0; i < 2; i++)
		{
			ivec2 source = clamp(texel * 2 - 1 + pc.Parity.xy + ivec2(i, j), ivec2(0), last);
			vec2 span = imageLoad(Heights, pc.Origins.xy + source).xy;
			height = vec2(max(height.x, span.x), min(height.y, span.y));
			radiance += texelFetch(SourceRadiance, source, 0).rgb;
			emitter += texelFetch(SourceEmitter, source, 0);
		}
	imageStore(Heights, pc.Origins.zw + texel, vec4(height, 0.0, 0.0));
	imageStore(TargetRadiance, texel, vec4(radiance * 0.25, 1.0));
	imageStore(TargetEmitter, texel, emitter * 0.25);
}
