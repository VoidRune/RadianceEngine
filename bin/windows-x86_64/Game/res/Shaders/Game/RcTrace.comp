#version 450
#extension GL_EXT_nonuniform_qualifier : require
#include "GBuffer.glsl"
#include "Brdf.glsl"
#include "Rc.glsl"
#include "Environment.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 1) uniform sampler2D DepthLevels[LevelCount];
layout(set = 0, binding = 2) uniform sampler2D RadianceLevels[LevelCount];
layout(set = 0, binding = 3) uniform sampler2D EmitterLevels[LevelCount];
layout(set = 0, binding = 4) uniform sampler2D Upper;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D Merged;
layout(set = 0, binding = 6) uniform sampler2D EnvironmentMap;
layout(set = 0, binding = 7) uniform sampler2D SkyMask;

layout(push_constant) uniform PushConstants
{
	uvec4 Cascade;
	uvec4 Grid;
	vec4 Interval;
	vec4 UpperTexel;
	vec4 Offsets;
} pc;

const vec3 Luma = vec3(0.2126, 0.7152, 0.0722);
#ifdef RECONNECT
const bool Reconnect = true;
#else
const bool Reconnect = false;
#endif

vec4 March(vec3 origin, vec3 start, vec3 end, uint steps)
{
	float near = Rc.Projection.z;
	if (start.z < near && end.z < near)
		return vec4(0.0, 0.0, 0.0, 1.0);
	if (start.z < near)
		start = mix(start, end, (near - start.z) / (end.z - start.z));
	else if (end.z < near)
		end = mix(start, end, (start.z - near) / (start.z - end.z));
	vec3 first = DomainHomogeneous(start);
	vec3 last = DomainHomogeneous(end);
	float stride = length(last.xy / max(last.z, 1e-6) - first.xy / max(first.z, 1e-6)) / float(steps);
	int level = clamp(int(floor(log2(max(stride, 1.0)) + 0.5)), 0, LevelCount - 1);
	float footprint = 0.35 * float(1 << level);
	float stepLength = length(end - start) / float(steps);
	float stepDepth = (end.z - start.z) / float(steps);
	float radius = Rc.Trace.z;
	vec3 radiance = vec3(0.0);
	for (uint i = 0u; i < steps; i++)
	{
		float t = (float(i) + 0.5) / float(steps);
		vec3 p = mix(start, end, t);
		vec3 h = mix(first, last, t);
		vec2 coordinate = h.xy / max(h.z, 1e-6);
		if (h.z <= 1e-4 || any(lessThan(coordinate, vec2(0.0))) || any(greaterThan(coordinate, Rc.Domain.xy)))
			break;
		float texelWorld = Rc.Domain.z * h.z;
		float cone = length(p - origin) * pc.UpperTexel.w / texelWorld;
		int filtered = clamp(int(ceil(log2(max(cone, 1.0)))), level, LevelCount - 1);
		vec4 emitter = textureLod(EmitterLevels[nonuniformEXT(filtered)], LevelUv(coordinate, filtered), 0.0);
		float luminance = dot(emitter.rgb, Luma);
		if (luminance > 1e-5)
		{
			float z = emitter.a / luminance;
			float low = p.z - 0.5 * abs(stepDepth);
			float high = p.z + 0.5 * abs(stepDepth);
			float inside = abs(stepDepth) > 1e-4 ? clamp((min(high, z + radius) - max(low, z - radius)) / abs(stepDepth), 0.0, 1.0) : float(abs(p.z - z) < radius);
			radiance += emitter.rgb * (inside * stepLength / (2.0 * radius));
		}
		float trail = p.z - abs(stepDepth);
		vec2 coarse = texelFetch(DepthLevels[nonuniformEXT(level)], LevelTexel(coordinate, level), 0).xy;
		if (p.z > coarse.x + Rc.Trace.w + footprint * texelWorld && trail < coarse.y)
		{
			vec2 exact = texelFetch(DepthLevels[0], LevelTexel(coordinate, 0), 0).xy;
			if (level == 0 || (p.z > exact.x + Rc.Trace.w && trail < exact.y))
				return vec4(radiance + textureLod(RadianceLevels[nonuniformEXT(filtered)], LevelUv(coordinate, filtered), 0.0).rgb, 0.0);
		}
	}
	return vec4(radiance, 1.0);
}

vec4 UpperRadiance(ivec2 probe, ivec2 direction)
{
	return textureLod(Upper, (vec2(probe * int(pc.UpperTexel.z) + direction * 2) + 1.0) * pc.UpperTexel.xy, 0.0);
}

vec4 Continue(vec4 traced, vec4 upper)
{
	return vec4(traced.rgb + traced.a * upper.rgb, traced.a * upper.a);
}

vec3 SkyRadiance(vec3 worldDirection)
{
	return Rc.Environment.x > 0.0 ? SampleEnvironment(EnvironmentMap, Rc.Environment, worldDirection, 1.0 / max(Rc.Environment.w, 1.0)) : EnvironmentRadiance(worldDirection);
}

vec4 ExtendRay(vec3 origin, vec3 from, vec3 rayDirection, vec3 worldDirection)
{
	vec4 traced = March(origin, from, from + rayDirection * max(Rc.Shading.z - pc.Interval.y, 0.0), 8u);
	float open = Rc.Environment.x > 0.0 ? SkyOpenness(SkyMask, Rc.SkyMaskTransform, (Rc.InverseView * vec4(origin, 1.0)).xyz) : 1.0;
	return vec4(traced.rgb + traced.a * open * SkyRadiance(worldDirection), traced.a * open);
}

vec4 MergeUpper(ivec2 probeTexel, vec3 origin, vec3 normal, vec3 start, vec3 rayDirection, ivec2 direction, vec3 worldDirection)
{
	float spacing = pc.Interval.w;
	vec2 grid = ProbeGrid(vec2(probeTexel), spacing, pc.Offsets.zw);
	ivec2 base = ivec2(floor(grid));
	vec2 f = grid - vec2(base);
	float tolerance = 0.5 * spacing * DomainTexelWorld(origin) + 0.1;
	vec3 end = origin + normal * Rc.Trace.y + rayDirection * pc.Interval.y;
	vec3 middle = mix(start, end, 0.6);
	uint branchSteps = max(pc.Cascade.y * 3u / 8u, 2u);
	vec4 prefix = Reconnect ? March(origin, start, middle, max(pc.Cascade.y * 5u / 8u, 2u)) : vec4(0.0, 0.0, 0.0, 1.0);
	if (prefix.a <= 0.0)
		return prefix;
	vec4 sum = vec4(0.0);
	float total = 0.0;
	for (int j = 0; j < 2; j++)
		for (int i = 0; i < 2; i++)
		{
			ivec2 probe = clamp(base + ivec2(i, j), ivec2(0), ivec2(pc.Grid.zw) - 1);
			float bilinear = (i == 0 ? 1.0 - f.x : f.x) * (j == 0 ? 1.0 - f.y : f.y);
			ivec2 texel = ProbeTexel(probe, spacing, pc.Offsets.zw);
			vec4 surface = texelFetch(DepthLevels[0], texel, 0);
			if (IsBackground(surface.x))
				continue;
			vec3 position = DomainView(texel, surface.x);
			float weight = bilinear * PlaneWeight(position, origin, normal, tolerance);
			if (weight <= 0.0)
				continue;
			vec4 upper = UpperRadiance(probe, direction);
			if (Reconnect)
				upper = Continue(March(origin, middle, position + mat3(Rc.View) * DecodeNormal(surface.zw) * Rc.Trace.y + rayDirection * pc.Interval.y, branchSteps), upper);
			sum += upper * weight;
			total += weight;
		}
	vec4 matched = sum / max(total, 1e-6);
	float confidence = smoothstep(0.05, 0.3, total);
	if (confidence >= 1.0)
		return Reconnect ? Continue(prefix, matched) : matched;
	vec4 fallback = ExtendRay(origin, end, rayDirection, worldDirection);
	if (Reconnect)
		fallback = Continue(March(origin, middle, end, branchSteps), fallback);
	return Continue(prefix, mix(fallback, matched, confidence));
}

void main()
{
	ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
	int directions = int(pc.Cascade.x);
	ivec2 probe = texel / directions;
	if (probe.x >= int(pc.Grid.x) || probe.y >= int(pc.Grid.y))
		return;
	ivec2 direction = texel - probe * directions;
	vec3 worldDirection = TileDirection(direction, directions);
	ivec2 probeTexel = ProbeTexel(probe, pc.Interval.z, pc.Offsets.xy);
	vec4 surface = texelFetch(DepthLevels[0], probeTexel, 0);
	if (IsBackground(surface.x))
		return;
	vec3 worldNormal = DecodeNormal(surface.zw);
	if (pc.Cascade.w != 0u && dot(worldDirection, worldNormal) < -0.15)
	{
		imageStore(Merged, texel, vec4(texelFetch(RadianceLevels[0], probeTexel, 0).rgb, 0.0));
		return;
	}
	vec3 origin = DomainView(probeTexel, surface.x);
	vec3 normal = mat3(Rc.View) * worldNormal;
	vec3 rayDirection = mat3(Rc.View) * worldDirection;
	vec3 base = origin + normal * Rc.Trace.y;
	vec3 start = base + rayDirection * pc.Interval.x;
	vec4 result;
	if (pc.Cascade.z != 0u)
	{
		vec4 traced = March(origin, start, base + rayDirection * pc.Interval.y, pc.Cascade.y);
		float open = Rc.Environment.x > 0.0 ? SkyOpenness(SkyMask, Rc.SkyMaskTransform, (Rc.InverseView * vec4(origin, 1.0)).xyz) : 1.0;
		float visibility = traced.a * open;
		result = vec4(traced.rgb + visibility * SkyRadiance(worldDirection), visibility);
	}
	else if (Reconnect)
		result = MergeUpper(probeTexel, origin, normal, start, rayDirection, direction, worldDirection);
	else
	{
		vec4 traced = March(origin, start, base + rayDirection * pc.Interval.y, pc.Cascade.y);
		result = traced.a > 0.0 ? Continue(traced, MergeUpper(probeTexel, origin, normal, start, rayDirection, direction, worldDirection)) : traced;
	}
	imageStore(Merged, texel, result);
}
