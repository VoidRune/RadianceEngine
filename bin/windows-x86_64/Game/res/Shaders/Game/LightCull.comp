#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D DepthBuffer;
layout(std430, set = 0, binding = 1) readonly buffer LightList
{
	vec4 Lights[];
};
layout(std430, set = 0, binding = 2) writeonly buffer TileMasks
{
	uint Masks[];
};
layout(push_constant) uniform CullConstants
{
	mat4 InverseViewProjection;
	uvec4 Info;
} Cull;

const uint Tile = 16u;
const uint MaskWords = 8u;
const uint Threads = 64u;
const uint Empty = 0x3F800000u;

shared uint DepthLow;
shared uint DepthHigh;
shared uint Mask[MaskWords];
shared vec3 Corners[8];

void main()
{
	uint index = gl_LocalInvocationIndex;
	if (index == 0u)
	{
		DepthLow = Empty;
		DepthHigh = 0u;
	}
	if (index < MaskWords)
		Mask[index] = 0u;
	barrier();

	ivec2 size = ivec2(Cull.Info.xy);
	ivec2 origin = ivec2(gl_WorkGroupID.xy * Tile + gl_LocalInvocationID.xy * 2u);
	uint low = Empty;
	uint high = 0u;
	for (int i = 0; i < 4; i++)
	{
		ivec2 pixel = origin + ivec2(i & 1, i >> 1);
		float depth = all(lessThan(pixel, size)) ? texelFetch(DepthBuffer, pixel, 0).r : 1.0;
		if (depth < 1.0)
		{
			low = min(low, floatBitsToUint(depth));
			high = max(high, floatBitsToUint(depth));
		}
	}
	low = subgroupMin(low);
	high = subgroupMax(high);
	if (subgroupElect())
	{
		atomicMin(DepthLow, low);
		atomicMax(DepthHigh, high);
	}
	barrier();

	uint tile = (gl_WorkGroupID.y * Cull.Info.w + gl_WorkGroupID.x) * MaskWords;
	if (DepthLow == Empty)
	{
		if (index < MaskWords)
			Masks[tile + index] = 0u;
		return;
	}
	if (index < 8u)
	{
		vec2 tileLow = vec2(gl_WorkGroupID.xy * Tile) / vec2(size);
		vec2 tileHigh = min(vec2((gl_WorkGroupID.xy + 1u) * Tile) / vec2(size), vec2(1.0));
		vec2 screen = vec2((index & 1u) != 0u ? tileHigh.x : tileLow.x, (index & 2u) != 0u ? tileHigh.y : tileLow.y);
		vec4 world = Cull.InverseViewProjection * vec4(screen * 2.0 - 1.0, uintBitsToFloat((index & 4u) != 0u ? DepthHigh : DepthLow), 1.0);
		Corners[index] = world.xyz / world.w;
	}
	barrier();

	vec3 boundsLow = Corners[0];
	vec3 boundsHigh = Corners[0];
	for (int corner = 1; corner < 8; corner++)
	{
		boundsLow = min(boundsLow, Corners[corner]);
		boundsHigh = max(boundsHigh, Corners[corner]);
	}
	for (uint light = index; light < Cull.Info.z; light += Threads)
	{
		vec4 place = Lights[light * 2u];
		vec3 offset = clamp(place.xyz, boundsLow, boundsHigh) - place.xyz;
		if (dot(offset, offset) < place.w * place.w)
			atomicOr(Mask[light >> 5u], 1u << (light & 31u));
	}
	barrier();

	if (index < MaskWords)
		Masks[tile + index] = Mask[index];
}
