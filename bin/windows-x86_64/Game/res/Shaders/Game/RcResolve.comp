#version 450
#include "GBuffer.glsl"
#include "Brdf.glsl"
#include "Rc.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 1) uniform sampler2D Merged;
layout(set = 0, binding = 2) uniform sampler2D GiDepth;
layout(set = 0, binding = 3, rgba32ui) uniform writeonly uimage2D ShPrimary;
layout(set = 0, binding = 4, rg32ui) uniform writeonly uimage2D ShSecondary;
layout(set = 0, binding = 5, r16f) uniform writeonly image2D ProbeDepth;
layout(set = 0, binding = 6) uniform usampler2D HistoryPrimary;
layout(set = 0, binding = 7) uniform usampler2D HistorySecondary;
layout(set = 0, binding = 8) uniform sampler2D HistoryDepth;

layout(push_constant) uniform PushConstants
{
	vec4 Probes;
	ivec4 History;
} pc;

const vec3 Luma = vec3(0.2126, 0.7152, 0.0722);

void main()
{
	ivec2 probe = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(ShPrimary);
	if (probe.x >= size.x || probe.y >= size.y)
		return;
	float depth = texelFetch(GiDepth, ProbeTexel(probe, pc.Probes.x, pc.Probes.yz), 0).x;
	if (IsBackground(depth))
	{
		imageStore(ShPrimary, probe, uvec4(0u));
		imageStore(ShSecondary, probe, uvec4(0u));
		imageStore(ProbeDepth, probe, vec4(depth));
		return;
	}
	vec3 average = vec3(0.0);
	vec3 x = vec3(0.0);
	vec3 y = vec3(0.0);
	vec3 z = vec3(0.0);
	for (int j = 0; j < 4; j++)
		for (int i = 0; i < 4; i++)
		{
			vec3 direction = TileDirection(ivec2(i, j), 4);
			vec3 radiance = texelFetch(Merged, probe * 4 + ivec2(i, j), 0).rgb * Rc.SolidAngles[j][i];
			average += radiance;
			x += radiance * direction.x;
			y += radiance * direction.y;
			z += radiance * direction.z;
		}
	average *= 0.25 * InvPi;
	x *= 0.5 * InvPi;
	y *= 0.5 * InvPi;
	z *= 0.5 * InvPi;

	ivec2 previous = probe + pc.History.xy;
	if (pc.History.z != 0 && all(greaterThanEqual(previous, ivec2(0))) && all(lessThan(previous, textureSize(HistoryDepth, 0))))
	{
		float past = texelFetch(HistoryDepth, previous, 0).x;
		if (!IsBackground(past) && abs(past - depth) < 0.25 + 0.03 * depth)
		{
			uvec4 primary = texelFetch(HistoryPrimary, previous, 0);
			uvec2 secondary = texelFetch(HistorySecondary, previous, 0).xy;
			vec3 pastAverage = vec3(unpackHalf2x16(primary.x), unpackHalf2x16(primary.y).x);
			vec3 pastX = vec3(unpackHalf2x16(primary.y).y, unpackHalf2x16(primary.z));
			vec3 pastY = vec3(unpackHalf2x16(primary.w), unpackHalf2x16(secondary.x).x);
			vec3 pastZ = vec3(unpackHalf2x16(secondary.x).y, unpackHalf2x16(secondary.y));
			vec3 directional = vec3(dot(x, Luma), dot(y, Luma), dot(z, Luma));
			vec3 pastDirectional = vec3(dot(pastX, Luma), dot(pastY, Luma), dot(pastZ, Luma));
			float level = dot(average, Luma);
			float pastLevel = dot(pastAverage, Luma);
			float change = (abs(level - pastLevel) + length(directional - pastDirectional)) / (level + pastLevel + 1e-3);
			float blend = clamp(0.25 + 3.0 * change, 0.25, 1.0);
			average = mix(pastAverage, average, blend);
			x = mix(pastX, x, blend);
			y = mix(pastY, y, blend);
			z = mix(pastZ, z, blend);
		}
	}
	imageStore(ShPrimary, probe, uvec4(packHalf2x16(average.rg), packHalf2x16(vec2(average.b, x.r)), packHalf2x16(x.gb), packHalf2x16(y.rg)));
	imageStore(ShSecondary, probe, uvec4(packHalf2x16(vec2(y.b, z.r)), packHalf2x16(z.gb), 0u, 0u));
	imageStore(ProbeDepth, probe, vec4(depth));
}
