#version 450
#include "Grass.glsl"

layout(std430, set = 0, binding = 0) readonly buffer FrameBuffer { GrassFrame Frame; };

struct GrassCommand
{
	uint IndexCount;
	uint InstanceCount;
	uint FirstIndex;
	int VertexOffset;
	uint FirstInstance;
};

const float Pi = 3.14159265;
const float TwoPi = 6.2831853;

#if defined(RESET)

layout(std430, set = 0, binding = 3) buffer CommandBuffer { GrassCommand Commands[]; };
layout(local_size_x = 1) in;

void main()
{
	for (uint i = 0u; i < GrassKinds; i++)
		Commands[i] = GrassCommand(Frame.Draws[i].x, 0u, Frame.Draws[i].y, 0, Frame.Draws[i].z);
}

#elif defined(FINISH)

layout(std430, set = 0, binding = 3) buffer CommandBuffer { GrassCommand Commands[]; };
layout(local_size_x = 1) in;

void main()
{
	for (uint i = 0u; i < GrassKinds; i++)
		Commands[i].InstanceCount = min(Commands[i].InstanceCount, Frame.Draws[i].w);
}

#elif defined(EFFECTS)

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 4, rgba16f) uniform image2D Effects;

shared uint StampList[GrassMaxStamps];
shared uint StampCount;

vec2 Stronger(vec2 current, vec2 push)
{
	return dot(push, push) > dot(current, current) ? push : current;
}

void main()
{
	if (gl_LocalInvocationIndex == 0u)
		StampCount = 0u;
	barrier();
	vec2 tileMin = Frame.Effects.xy + vec2(gl_WorkGroupID.xy * 8u) / Frame.Effects.z;
	vec2 tileMax = tileMin + vec2(8.0) / Frame.Effects.z;
	for (uint s = gl_LocalInvocationIndex; s < Frame.Counts.z; s += 64u)
	{
		vec4 center = Frame.Stamps[s * 3u];
		vec4 extent = Frame.Stamps[s * 3u + 1u];
		float reach = max(extent.x, extent.y) + extent.z;
		if (distance(clamp(center.xz, tileMin, tileMax), center.xz) <= reach)
			StampList[atomicAdd(StampCount, 1u)] = s;
	}
	barrier();
	ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(texel, imageSize(Effects))))
		return;
	vec4 value = imageLoad(Effects, texel);
	float dt = Frame.Effects.w;
	float burn = value.x > 1.0 ? max(value.x - dt * Frame.Decay.y, 1.0) : max(value.x - dt * Frame.Decay.x, 0.0);
	float frost = max(value.y - dt * Frame.Decay.z, 0.0);
	vec2 laid = value.zw * exp(-dt * Frame.Decay.w);
	if (dot(laid, laid) < 1e-5)
		laid = vec2(0.0);
	vec2 p = Frame.Effects.xy + vec2(texel) / Frame.Effects.z;
	for (uint k = 0u; k < StampCount; k++)
	{
		uint s = StampList[k];
		vec4 center = Frame.Stamps[s * 3u];
		vec4 extent = Frame.Stamps[s * 3u + 1u];
		vec4 params = Frame.Stamps[s * 3u + 2u];
		uint kind = uint(extent.w + 0.5);
		vec2 d = p - center.xz;
		float dist = length(d);
		vec2 radial = dist > 1e-3 ? d / dist : vec2(0.0);
		if (kind == StampWave)
		{
			float band = 1.0 - abs(dist - extent.x) / max(extent.z, 1e-3);
			if (band <= 0.0)
				continue;
			if (params.w < 3.1)
			{
				float off = abs(mod(atan(d.y, d.x) - params.z + Pi, TwoPi) - Pi);
				band *= 1.0 - smoothstep(params.w * 0.85, params.w + 0.05, off);
			}
			laid = Stronger(laid, radial * (params.x * band));
			continue;
		}
		float c = cos(center.w);
		float sn = sin(center.w);
		vec2 local = vec2(d.x * c + d.y * sn, d.y * c - d.x * sn) / max(extent.xy, vec2(1e-3));
		float fall = 1.0 - smoothstep(0.6, 1.0, length(local));
		if (fall <= 0.0)
			continue;
		float strength = params.x * fall;
		if (kind == StampBurn)
		{
			burn = max(burn, strength);
			if (params.y * fall > 0.02)
				burn = max(burn, 1.0 + params.y * fall);
		}
		else if (kind == StampFrost)
			frost = max(frost, strength);
		else if (kind == StampFlatten)
			laid = Stronger(laid, radial * strength);
		else
		{
			vec2 lay = radial * 0.55 + params.zw * 0.9;
			laid = Stronger(laid, (dot(lay, lay) > 1e-6 ? normalize(lay) : radial) * strength);
		}
	}
	float amount = length(laid);
	if (amount > 1.0)
		laid /= amount;
	imageStore(Effects, texel, vec4(burn, frost, laid));
}

#else

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 1) uniform sampler2D Field;
layout(std430, set = 0, binding = 2) writeonly buffer BladeBuffer { GrassBlade Blades[]; };
layout(std430, set = 0, binding = 3) buffer CommandBuffer { GrassCommand Commands[]; };
layout(set = 0, binding = 4) uniform sampler2D Effects;

shared uint GroupCount[GrassKinds];
shared uint GroupBase[GrassKinds];

bool Visible(vec3 center, float radius)
{
	mat4 m = Frame.ViewProjection;
	vec4 x = vec4(m[0][0], m[1][0], m[2][0], m[3][0]);
	vec4 y = vec4(m[0][1], m[1][1], m[2][1], m[3][1]);
	vec4 w = vec4(m[0][3], m[1][3], m[2][3], m[3][3]);
	vec4 planes[4] = vec4[](w + x, w - x, w + y, w - y);
	for (int i = 0; i < 4; i++)
		if (dot(planes[i], vec4(center, 1.0)) < -radius * length(planes[i].xyz))
			return false;
	return dot(w, vec4(center, 1.0)) > -radius;
}

bool Build(ivec2 cell, out GrassBlade blade, out uint kind)
{
	blade.BaseHeight = vec4(0.0);
	blade.Shape = uvec4(0u);
	kind = GrassNear;
	uint h = GrassHash2(cell, 1u);
	vec2 p = (vec2(cell) + vec2(GrassUnit(h), GrassUnit(GrassHash(h ^ 0x5bd1e995u)))) * Frame.Grid.x;
	vec2 uv = ((p - Frame.Field.xy) * Frame.Field.z + 0.5) * Frame.FieldSize.zw;
	if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))))
		return false;
	vec4 field = textureLod(Field, uv, 0.0);
	float patches = GrassNoise(p * 0.45 + 17.0);
	if (GrassUnit(GrassHash(h ^ 0x9e3779b9u)) >= field.g * mix(0.7, 1.0, patches))
		return false;
	if (!Visible(vec3(p.x, field.r + 0.6 * Frame.Shape.x, p.y), 2.2 * Frame.Shape.x + Frame.Shape.z))
		return false;

	vec4 fx = textureLod(Effects, ((p - Frame.Effects.xy) * Frame.Effects.z + 0.5) * Frame.EffectSize.zw, 0.0);
	float charred = clamp(fx.x, 0.0, 1.0);
	float heat = clamp(fx.x - 1.0, 0.0, 1.0);
	float frost = clamp(fx.y, 0.0, 1.0);
	vec2 laid = fx.zw;
	float laidAmount = min(length(laid), 1.0);

	float lush = smoothstep(0.0, 0.6, field.g);
	float clover = smoothstep(0.62, 0.74, GrassNoise(p * 0.32 + vec2(41.0, 7.0))) * lush;
	vec2 flowerCoord = p * 0.21 + vec2(-13.0, 29.0);
	float flowers = smoothstep(0.64, 0.8, GrassNoise(flowerCoord)) * lush;
	float pick = GrassUnit(GrassHash(h ^ 0x3c6ef372u));
	float flowerChance = 0.02 * Frame.Grid.y * flowers;
	float cloverChance = 0.05 * Frame.Grid.y * clover;
	if (pick < flowerChance)
		kind = GrassFlower;
	else if (pick < flowerChance + cloverChance)
		kind = GrassClover;
	else if (GrassUnit(GrassHash(h ^ 0xa54ff53au)) < 0.6 * clover)
		return false;
	float stagger = GrassUnit(GrassHash(h ^ 0x510e527fu));
	float burnt = smoothstep(0.1 + 0.35 * stagger, 0.55 + 0.4 * stagger, charred);
	if (kind != GrassNear && burnt > 0.92)
		return false;

	float clumpSize = Frame.Dry.w;
	vec2 cp = p / clumpSize;
	ivec2 cc = ivec2(floor(cp));
	float best = 1e9;
	vec2 center = cp;
	uint id = 0u;
	for (int dy = -1; dy <= 1; dy++)
		for (int dx = -1; dx <= 1; dx++)
		{
			ivec2 c = cc + ivec2(dx, dy);
			uint ch = GrassHash2(c, 7u);
			vec2 q = vec2(c) + 0.15 + 0.7 * vec2(GrassUnit(ch), GrassUnit(GrassHash(ch ^ 0x2545f491u)));
			float d2 = dot(q - cp, q - cp);
			if (d2 < best)
			{
				best = d2;
				center = q;
				id = ch;
			}
		}
	float dist = sqrt(best);
	float clumpRand = GrassUnit(GrassHash(id ^ 0x51ed270bu));
	float clumpAngle = GrassUnit(GrassHash(id ^ 0x93a5c2f1u)) * TwoPi;
	float ownAngle = GrassUnit(GrassHash(h ^ 0x27d4eb2fu)) * TwoPi;
	vec2 away = dist > 1e-4 ? (cp - center) / dist : vec2(1.0, 0.0);
	vec2 dir = vec2(cos(ownAngle), sin(ownAngle)) * 0.5 + vec2(cos(clumpAngle), sin(clumpAngle)) * 0.35 + away * 0.65;
	dir = length(dir) > 1e-4 ? normalize(dir) : vec2(1.0, 0.0);
	float phase = GrassUnit(GrassHash(h ^ 0x68e31da4u)) * TwoPi;
	float r1 = GrassUnit(GrassHash(h ^ 0x165667b1u));
	float r2 = GrassUnit(GrassHash(h ^ 0xd3a2646cu));
	float r3 = GrassUnit(GrassHash(h ^ 0xfd7046c5u));
	vec3 base = vec3(p.x, field.r - 0.03, p.y);
	float tone = field.a;
	float height;
	float bend;
	float width;

	if (kind == GrassFlower)
	{
		height = Frame.Shape.x * (1.45 + 0.4 * r1) * (1.0 - burnt);
		bend = 0.12 + 0.12 * r2;
		width = (0.06 + 0.025 * r3) * (1.0 - burnt);
		uint meadow = GrassHash2(ivec2(floor(flowerCoord)), 13u);
		uint colour = GrassUnit(GrassHash(h ^ 0x6a09e667u)) < 0.15 ? GrassHash(h ^ 0xbb67ae85u) % 5u : meadow % 5u;
		tone = float(colour) / 7.0;
	}
	else if (kind == GrassClover)
	{
		height = (0.05 + 0.05 * r1) * (1.0 - burnt);
		bend = 0.25 + 0.25 * r2;
		width = (0.055 + 0.025 * r3) * (1.0 - burnt);
		dir = vec2(cos(ownAngle), sin(ownAngle));
	}
	else
	{
		height = Frame.Shape.x * (1.0 + Frame.Shape.y * (clumpRand * 2.0 - 1.0));
		height *= 1.0 - 0.4 * smoothstep(0.15, 0.9, dist);
		height *= 0.75 + 0.5 * r1;
		height *= mix(0.4, 1.0, lush) * mix(0.85, 1.1, patches);
		height *= (1.0 - 0.45 * clover) * mix(1.0, stagger < 0.6 ? 0.22 : 0.03, burnt);
		bend = Frame.Shape.w * (0.5 + r2) * (0.6 + 0.7 * smoothstep(0.2, 0.9, dist));
		width = Frame.Shape.z * (0.75 + 0.5 * r3);
		float lod = smoothstep(Frame.Grid.z, Frame.Grid.w, distance(Frame.Eye.xyz, base));
		if (GrassUnit(GrassHash(h ^ 0x9b05688cu)) < lod)
		{
			kind = GrassFar;
			if (GrassUnit(GrassHash(h ^ 0x1f83d9abu)) < 0.2 * lod)
				return false;
			width *= 1.0 + 0.2 * lod;
		}
	}
	if (kind != GrassClover)
	{
		vec2 lean = dir * bend + laid * 2.4;
		bend = length(lean);
		dir = bend > 1e-4 ? lean / bend : dir;
		height *= 1.0 - 0.25 * laidAmount;
	}
	if (!Visible(base + vec3(0.0, 0.5 * height, 0.0), height + width))
		return false;

	blade.BaseHeight = vec4(base, height);
	blade.Shape = uvec4(packHalf2x16(vec2(atan(dir.y, dir.x), bend)), packHalf2x16(vec2(width, phase)), packUnorm4x8(vec4(field.b, tone, clumpRand, lush)),
		packUnorm4x8(vec4(charred, heat, frost, laidAmount)));
	return true;
}

void main()
{
	if (gl_LocalInvocationIndex < GrassKinds)
		GroupCount[gl_LocalInvocationIndex] = 0u;
	barrier();
	ivec2 local = ivec2(gl_GlobalInvocationID.xy);
	GrassBlade blade;
	uint kind = GrassNear;
	bool alive = all(lessThan(local, Frame.Region.zw)) && Build(Frame.Region.xy + local, blade, kind);
	uint slot = alive ? atomicAdd(GroupCount[kind], 1u) : 0u;
	barrier();
	if (gl_LocalInvocationIndex < GrassKinds)
	{
		uint count = GroupCount[gl_LocalInvocationIndex];
		GroupBase[gl_LocalInvocationIndex] = count > 0u ? atomicAdd(Commands[gl_LocalInvocationIndex].InstanceCount, count) : 0u;
	}
	barrier();
	if (!alive)
		return;
	uint index = GroupBase[kind] + slot;
	if (index < Frame.Draws[kind].w)
		Blades[Frame.Draws[kind].z + index] = blade;
}

#endif
