#version 450
#include "GBuffer.glsl"
#include "Brdf.glsl"
#include "Environment.glsl"
#include "Backdrop.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D AlbedoBuffer;
layout(set = 0, binding = 1) uniform sampler2D SurfaceBuffer;
layout(set = 0, binding = 2) uniform sampler2D EmissionBuffer;
layout(set = 0, binding = 3) uniform sampler2D DepthBuffer;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D SceneColor;
layout(std140, set = 0, binding = 5) uniform LightingFrame
{
	mat4 InverseViewProjection;
	vec4 CameraPosition;
	vec4 SunDirection;
	vec4 SunRadiance;
	vec4 SkyRadiance;
	vec4 GroundRadiance;
	vec4 Background;
	uvec4 Options;
	mat4 ShadowMatrix;
	vec4 ShadowParams;
	vec4 GiParams;
	vec4 EnvironmentSh[9];
	vec4 EnvironmentParams;
	vec4 SkyMaskTransform;
	vec4 Backdrop;
	vec4 Haze;
	vec4 Eye;
	vec4 Translucent;
	vec4 Lights[32];
} Frame;
layout(set = 0, binding = 6) uniform sampler2D ShadowMap;
layout(set = 0, binding = 11) uniform sampler2D EnvironmentMap;
layout(set = 0, binding = 12) uniform sampler2D SkyMask;
#ifdef GLOBAL_ILLUMINATION
layout(set = 0, binding = 7) uniform sampler2D EmitterLight;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D GiSource;
#endif

const uint ViewLit = 0u;
const uint ViewAlbedo = 1u;
const uint ViewNormal = 2u;
const uint ViewRoughness = 3u;
const uint ViewMetallic = 4u;
const uint ViewOcclusion = 5u;
const uint ViewEmission = 6u;
const uint ViewSun = 7u;
const uint ViewAmbient = 8u;
const uint ViewShadow = 9u;
const uint ViewIrradiance = 10u;
const uint ViewGiSource = 11u;
const uint ViewTranslucency = 12u;

const uint ShadowsOff = 0u;
const uint ShadowsLow = 1u;

const float WrapLight = 0.45;
const float BackDistortion = 0.35;
const float BackPower = 3.0;
const float BackScale = 1.6;
const float BackAmbient = 0.15;
const float SpellAmbient = 0.6;
const float SkyThrough = 0.45;
const float SunExtinction = 1.8;

vec3 LinearToSrgb(vec3 color)
{
	return mix(color * 12.92, 1.055 * pow(color, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), color));
}

vec4 GatherLit(vec2 corner, vec2 size, float depth)
{
	return step(vec4(depth), textureGather(ShadowMap, corner / size, 0));
}

float SunShadow(vec3 position, vec3 normal, float cosI)
{
	uint quality = Frame.Options.w;
	if (quality == ShadowsOff)
		return 1.0;
	vec3 coord = (Frame.ShadowMatrix * vec4(position + normal * (Frame.ShadowParams.x * (1.5 - cosI)), 1.0)).xyz;
	if (any(lessThan(coord, vec3(0.0))) || any(greaterThan(coord, vec3(1.0))))
		return 1.0;
	float depth = coord.z - Frame.ShadowParams.y;
	vec2 size = vec2(textureSize(ShadowMap, 0));
	vec2 st = coord.xy * size - 0.5;
	vec2 base = floor(st);
	vec2 f = st - base;
	if (quality == ShadowsLow)
	{
		vec4 lit = GatherLit(base + 1.0, size, depth);
		return mix(mix(lit.w, lit.z, f.x), mix(lit.x, lit.y, f.x), f.y);
	}
	vec4 wx = vec4(1.0 - f.x, 1.0, 1.0, f.x);
	vec4 wy = vec4(1.0 - f.y, 1.0, 1.0, f.y);
	float sum = 0.0;
	for (int j = 0; j < 2; j++)
		for (int i = 0; i < 2; i++)
		{
			vec4 lit = GatherLit(base + vec2(2 * i, 2 * j), size, depth);
			vec2 x = vec2(wx[2 * i], wx[2 * i + 1]);
			vec2 y = vec2(wy[2 * j], wy[2 * j + 1]);
			sum += lit.w * x.x * y.x + lit.z * x.y * y.x + lit.x * x.x * y.y + lit.y * x.y * y.y;
		}
	return sum / 9.0;
}

float SunThrough(vec3 position, vec3 normal)
{
	if (Frame.Options.w == ShadowsOff)
		return 1.0;
	vec3 coord = (Frame.ShadowMatrix * vec4(position - normal * 0.03, 1.0)).xyz;
	if (any(lessThan(coord, vec3(0.0))) || any(greaterThan(coord, vec3(1.0))))
		return 1.0;
	float inside = max(coord.z - textureLod(ShadowMap, coord.xy, 0.0).r, 0.0) * Frame.ShadowParams.z;
	return exp(-SunExtinction * inside);
}

float BackLight(vec3 n, vec3 v, vec3 l, float ambient)
{
	vec3 h = normalize(l + n * BackDistortion);
	return pow(clamp(dot(v, -h), 0.0, 1.0), BackPower) * BackScale + max(-dot(n, l), 0.0) + ambient;
}

vec3 SpellTransmission(vec3 position, vec3 n, vec3 v)
{
	vec3 total = vec3(0.0);
	for (uint i = 0u; i < uint(Frame.Translucent.y); i++)
	{
		vec4 place = Frame.Lights[i * 2u];
		vec3 toLight = place.xyz - position;
		float distance2 = dot(toLight, toLight);
		float window = max(1.0 - distance2 / (place.w * place.w), 0.0);
		if (window <= 0.0)
			continue;
		vec3 l = toLight * inversesqrt(max(distance2, 1e-6));
		total += Frame.Lights[i * 2u + 1u].rgb * (window * window / (1.0 + 0.5 * distance2) * BackLight(n, v, l, SpellAmbient));
	}
	return total;
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = ivec2(Frame.Options.yz);
	if (any(greaterThanEqual(pixel, size)))
		return;
	float depth = texelFetch(DepthBuffer, pixel, 0).r;
	vec3 result = Frame.Background.rgb;
	vec3 source = vec3(0.0);
	float translucency = 0.0;
	float priority = 2.0;
	bool floating = Frame.Backdrop.x > 0.5;
	if (depth >= 1.0 && floating)
	{
		vec2 screen = (vec2(pixel) + 0.5) / vec2(size);
		vec4 far = Frame.InverseViewProjection * vec4(screen * 2.0 - 1.0, 1.0, 1.0);
		vec3 direction = normalize(far.xyz / far.w - Frame.CameraPosition.xyz);
		if (Frame.Backdrop.x > 2.5)
			result = StormSky(Frame.CameraPosition.xyz, direction, Frame.Backdrop.z, Frame.SunDirection.xyz, Frame.Eye, Frame.Haze.w);
		else if (Frame.Backdrop.x > 1.5)
			result = DaySky(Frame.CameraPosition.xyz, direction, Frame.Backdrop.z, Frame.SunDirection.xyz);
		else
			result = Backdrop(Frame.CameraPosition.xyz, direction, Frame.Backdrop.z, Frame.SunDirection.xyz, SkyMask, Frame.SkyMaskTransform, Frame.Backdrop.w);
	}
	if (depth < 1.0)
	{
		vec2 screen = (vec2(pixel) + 0.5) / vec2(size);
		vec4 world = Frame.InverseViewProjection * vec4(screen * 2.0 - 1.0, depth, 1.0);
		vec3 position = world.xyz / world.w;

		vec4 albedo = texelFetch(AlbedoBuffer, pixel, 0);
		vec4 surface = texelFetch(SurfaceBuffer, pixel, 0);
		vec4 emissive = texelFetch(EmissionBuffer, pixel, 0);
		vec3 emission = emissive.rgb;
		if (emissive.a > 0.5)
			priority = 1.0;
		vec3 n = DecodeNormal(surface.xy);
		float roughness = surface.z;
		float metallic = 1.0 - surface.w;
		vec3 v = normalize(Frame.CameraPosition.xyz - position);
		float cosO = dot(n, v);
		if (cosO < 0.01)
			n = normalize(n + v * (0.01 - cosO));

		vec3 l = Frame.SunDirection.xyz;
		float cosI = dot(n, l);
		float shadow = cosI > 0.0 ? SunShadow(position, n, cosI) : 0.0;
		vec3 sunIrradiance = Frame.SunRadiance.rgb * (max(cosI, 0.0) * shadow);
		if (Frame.Eye.w > 0.0)
			sunIrradiance *= mix(Frame.Eye.w, 1.0, 1.0 - smoothstep(Frame.Eye.z - 0.6, Frame.Eye.z + 1.6, length(position.xz - Frame.Eye.xy)));
		vec3 sun = EvaluateBrdf(albedo.rgb, metallic, roughness, n, v, l) * sunIrradiance;
		float fade = DepthFade(Frame.CameraPosition.w, position.y);
		bool environment = Frame.EnvironmentParams.x > 0.0;
		float open = environment ? SkyOpenness(SkyMask, Frame.SkyMaskTransform, position) : 1.0;
		vec3 environmentIrradiance = environment ? EnvironmentIrradiance(Frame.EnvironmentSh, Frame.EnvironmentParams, n) : vec3(0.0);
		vec3 skyIrradiance = environment ? environmentIrradiance * open : HemisphereRadiance(Frame.SkyRadiance.rgb, Frame.GroundRadiance.rgb, n.y, 1.0);
		translucency = Frame.Translucent.x > 0.0 ? UnpackTranslucency(emissive.a) : 0.0;
		vec3 transmitted = vec3(0.0);
		if (translucency > 0.0)
		{
			float through = SunThrough(position, n);
			float wrap = max((cosI + WrapLight) / (1.0 + WrapLight), 0.0) - max(cosI, 0.0);
			vec3 sunThrough = Frame.SunRadiance.rgb * (through * (wrap + BackLight(n, v, l, BackAmbient)));
			transmitted = sqrt(albedo.rgb) * (translucency * InvPi) * (sunThrough + SpellTransmission(position, n, v));
#ifndef GLOBAL_ILLUMINATION
			vec3 backSky = environment ? EnvironmentIrradiance(Frame.EnvironmentSh, Frame.EnvironmentParams, -n) * open : HemisphereRadiance(Frame.SkyRadiance.rgb, Frame.GroundRadiance.rgb, -n.y, 1.0);
			transmitted += sqrt(albedo.rgb) * backSky * (translucency * SkyThrough);
#endif
		}
#ifdef GLOBAL_ILLUMINATION
		vec3 ambient = vec3(0.0);
		vec2 border = min(vec2(pixel) + 0.5, vec2(size - pixel) - 0.5);
		float edge = clamp(min(border.x, border.y) / (2.0 * Frame.GiParams.z), 0.0, 1.0);
		source = (albedo.rgb * (sunIrradiance * InvPi + skyIrradiance * albedo.a) + transmitted) * (1.0 - fade) + emission * (Frame.GiParams.x * edge);
#else
		vec3 ambient;
		if (environment)
		{
			float floorOpen = max(open, 0.03);
			vec3 reflected = SampleEnvironment(EnvironmentMap, Frame.EnvironmentParams, DominantDirection(n, v, roughness), roughness) * floorOpen;
			ambient = CombineAmbient(albedo.rgb, metallic, roughness, n, v, environmentIrradiance * floorOpen, reflected) * albedo.a;
		}
		else
			ambient = EvaluateAmbient(albedo.rgb, metallic, roughness, albedo.a, n, v, Frame.SkyRadiance.rgb, Frame.GroundRadiance.rgb);
#endif
		vec3 lit = mix(sun + ambient + transmitted, DepthColor, fade);

		result = lit + emission;
		if (Frame.Backdrop.x > 2.5)
			result = ThroughDeck(result, Frame.CameraPosition.xyz, position, Frame.Backdrop.z, Frame.Haze.w);
		if (floating)
			result = mix(result, Frame.Haze.rgb, Haze(Frame.Backdrop.y, position.y));
		switch (Frame.Options.x)
		{
		case ViewAlbedo:
			result = LinearToSrgb(albedo.rgb);
			break;
		case ViewNormal:
			result = n * 0.5 + 0.5;
			break;
		case ViewRoughness:
			result = vec3(roughness);
			break;
		case ViewMetallic:
			result = vec3(metallic);
			break;
		case ViewOcclusion:
			result = vec3(albedo.a);
			break;
		case ViewEmission:
			result = emission;
			break;
		case ViewSun:
			result = sun;
			break;
		case ViewAmbient:
			result = ambient;
			break;
		case ViewShadow:
			result = vec3(shadow);
			break;
		case ViewIrradiance:
			result = skyIrradiance;
			break;
		case ViewTranslucency:
			result = vec3(translucency) * 0.25 + transmitted;
			break;
		case ViewGiSource:
			result = source;
#ifdef GLOBAL_ILLUMINATION
			result += texelFetch(EmitterLight, min(pixel / 2, textureSize(EmitterLight, 0) - 1), 0).rgb * Frame.GiParams.y;
#endif
			break;
		}
	}
#ifdef GLOBAL_ILLUMINATION
	imageStore(SceneColor, pixel, vec4(result, 1.0 + translucency));
	imageStore(GiSource, pixel, vec4(source, priority));
#else
	imageStore(SceneColor, pixel, vec4(result, 1.0));
#endif
}
