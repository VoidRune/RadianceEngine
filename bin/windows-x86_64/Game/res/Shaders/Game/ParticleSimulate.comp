#version 450
#include "Particles.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) buffer StateBuffer { ParticleState State; };
layout(std430, set = 0, binding = 1) buffer ParticleBuffer { Particle Particles[]; };
layout(std430, set = 0, binding = 2) buffer ListBuffer { uint Lists[]; };
layout(std430, set = 0, binding = 3) readonly buffer MaterialBuffer { ParticleMaterial Materials[]; };
layout(std430, set = 0, binding = 4) readonly buffer FrameBuffer { ParticleFrame Frame; };
layout(set = 0, binding = 5) uniform sampler2D SceneDepth;

const float CollisionThickness = 0.6;
const float KillHeight = -30.0;

vec3 Flow(vec3 p, float time)
{
	return vec3(
		sin(p.y * 1.7 + time * 1.3) + sin(p.z * 2.3 - time * 0.7),
		sin(p.z * 1.9 + time * 1.1) + sin(p.x * 1.3 + time * 0.9),
		sin(p.x * 2.1 - time * 1.2) + sin(p.y * 1.1 + time * 1.7)) * 0.5;
}

vec3 Unproject(vec2 uv)
{
	float depth = textureLod(SceneDepth, uv, 0.0).r;
	vec4 world = Frame.InverseViewProjection * vec4(uv * 2.0 - 1.0, depth, 1.0);
	return world.xyz / world.w;
}

vec3 Edge(vec2 uv, vec2 offset, vec3 surface)
{
	vec3 forward = Unproject(uv + offset) - surface;
	vec3 backward = surface - Unproject(uv - offset);
	return dot(forward, forward) <= dot(backward, backward) ? forward : backward;
}

bool Collide(inout vec3 position, inout vec3 velocity, ParticleMaterial material)
{
	vec4 clip = Frame.ViewProjection * vec4(position, 1.0);
	if (clip.w <= 1e-4)
		return false;
	vec3 ndc = clip.xyz / clip.w;
	if (abs(ndc.x) >= 0.995 || abs(ndc.y) >= 0.995)
		return false;
	vec2 uv = ndc.xy * 0.5 + 0.5;
	float depth = textureLod(SceneDepth, uv, 0.0).r;
	if (depth >= 1.0 || ndc.z <= depth)
		return false;
	vec4 hit = Frame.InverseViewProjection * vec4(ndc.xy, depth, 1.0);
	vec3 surface = hit.xyz / hit.w;
	if (dot(position - surface, Frame.CameraForward.xyz) > CollisionThickness)
		return false;

	vec2 texel = 2.0 / Frame.Screen.xy;
	vec3 normal = cross(Edge(uv, vec2(0.0, texel.y), surface), Edge(uv, vec2(texel.x, 0.0), surface));
	normal = dot(normal, normal) > 1e-12 ? normalize(normal) : vec3(0.0, 1.0, 0.0);
	if (dot(normal, Frame.CameraForward.xyz) > 0.0)
		normal = -normal;

	position = surface + normal * 0.03;
	float into = dot(velocity, normal);
	if (into < 0.0)
	{
		vec3 tangent = velocity - normal * into;
		velocity = tangent * (1.0 - material.Collision.y) - normal * (into * material.Collision.x);
	}
	return true;
}

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= State.AliveCount)
		return;
	uint capacity = Frame.Counts.w;
	uint parity = Frame.Counts.z;
	uint index = Lists[capacity * (1u + parity) + i];
	Particle particle = Particles[index];
	ParticleMaterial material = Materials[particle.Info.x];
	float dt = Frame.CameraUp.w;
	float age = particle.PositionAge.w + dt;
	float life = particle.VelocityLife.w;
	vec3 position = particle.PositionAge.xyz;
	vec3 velocity = particle.VelocityLife.xyz;
	if (age >= life || position.y < KillHeight)
	{
		Lists[atomicAdd(State.DeadCount, 1u)] = index;
		return;
	}

	velocity.y += material.Physics.x * dt;
	if (material.Physics.z > 0.0)
	{
		uint seed = particle.Info.y;
		vec3 offset = vec3(float(seed & 1023u), float((seed >> 10) & 1023u), float((seed >> 20) & 1023u)) * 0.01;
		velocity += Flow(position * material.Physics.w + offset, Frame.CameraRight.w) * (material.Physics.z * dt);
	}
	velocity *= exp(-material.Physics.y * dt);
	position += velocity * dt;
	if (material.Collision.z > 0.5 && age > 0.05 && Collide(position, velocity, material))
	{
		particle.Info.z += 1u;
		age += life * material.Collision.w;
	}

	particle.PositionAge = vec4(position, age);
	particle.VelocityLife.xyz = velocity;
	Particles[index] = particle;
	Lists[capacity * (2u - parity) + atomicAdd(State.NextAliveCount, 1u)] = index;
}
